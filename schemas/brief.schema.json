{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teashaman-cyber.github.io/theseus-tech-review-graph/schemas/brief.schema.json",
  "title": "Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "period_start",
    "period_end",
    "summary",
    "signal_ids",
    "theme_ids",
    "epistemic_state",
    "currentness_state"
  ],
  "properties": {
    "id": {
      "$ref": "https://teashaman-cyber.github.io/theseus-tech-review-graph/schemas/common.schema.json#/$defs/id"
    },
    "type": {
      "const": "Brief"
    },
    "period_start": {
      "$ref": "https://teashaman-cyber.github.io/theseus-tech-review-graph/schemas/common.schema.json#/$defs/isoDate"
    },
    "period_end": {
      "$ref": "https://teashaman-cyber.github.io/theseus-tech-review-graph/schemas/common.schema.json#/$defs/isoDate"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "signal_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://teashaman-cyber.github.io/theseus-tech-review-graph/schemas/common.schema.json#/$defs/id"
      }
    },
    "theme_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://teashaman-cyber.github.io/theseus-tech-review-graph/schemas/common.schema.json#/$defs/id"
      }
    },
    "epistemic_state": {
      "$ref": "https://teashaman-cyber.github.io/theseus-tech-review-graph/schemas/common.schema.json#/$defs/epistemicState"
    },
    "currentness_state": {
      "$ref": "https://teashaman-cyber.github.io/theseus-tech-review-graph/schemas/common.schema.json#/$defs/currentnessState"
    }
  }
}
