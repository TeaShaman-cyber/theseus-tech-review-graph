{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teashaman-cyber.github.io/theseus-tech-review-graph/schemas/signal.schema.json",
  "title": "Signal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "observed_on",
    "claim",
    "why_it_matters",
    "source_ids",
    "epistemic_state",
    "currentness_state",
    "provenance"
  ],
  "properties": {
    "id": {
      "$ref": "https://teashaman-cyber.github.io/theseus-tech-review-graph/schemas/common.schema.json#/$defs/id"
    },
    "type": {
      "const": "Signal"
    },
    "observed_on": {
      "$ref": "https://teashaman-cyber.github.io/theseus-tech-review-graph/schemas/common.schema.json#/$defs/isoDate"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "why_it_matters": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://teashaman-cyber.github.io/theseus-tech-review-graph/schemas/common.schema.json#/$defs/id"
      }
    },
    "actor_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://teashaman-cyber.github.io/theseus-tech-review-graph/schemas/common.schema.json#/$defs/id"
      }
    },
    "theme_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://teashaman-cyber.github.io/theseus-tech-review-graph/schemas/common.schema.json#/$defs/id"
      }
    },
    "epistemic_state": {
      "$ref": "https://teashaman-cyber.github.io/theseus-tech-review-graph/schemas/common.schema.json#/$defs/epistemicState"
    },
    "currentness_state": {
      "$ref": "https://teashaman-cyber.github.io/theseus-tech-review-graph/schemas/common.schema.json#/$defs/currentnessState"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_class",
        "intake_class"
      ],
      "properties": {
        "producer_class": {
          "enum": [
            "SCHEDULED_AGENT",
            "INTERACTIVE_AGENT",
            "HUMAN",
            "IMPORT",
            "OTHER"
          ]
        },
        "intake_class": {
          "enum": [
            "DOCUMENT",
            "DATABASE",
            "MESSAGE",
            "API",
            "FILESYSTEM",
            "OTHER"
          ]
        },
        "origin_label": {
          "type": "string"
        }
      }
    }
  }
}
